# Banco de dados Neon Postgres (use o endpoint -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# URL base do Neon Auth (Neon Console -> Branch -> Auth -> Configuration -> Auth Base URL)
NEON_AUTH_URL="https://ep-xxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth"

# Porta do servidor HTTP
PORT=4000

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:5173,https://seu-dominio.vercel.app"

# E-mails que recebem papel 'admin' automaticamente ao fazer login (separados por vírgula)
ADMIN_EMAILS="admin@medfocus.com"

# Executa migrações SQL idempotentes ao iniciar o servidor
RUN_MIGRATIONS_ON_START="true"
