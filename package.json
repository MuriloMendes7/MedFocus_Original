{
  "name": "medfocus",
  "version": "2.0.0",
  "private": true,
  "description": "Plataforma de estudos médicos com flashcards SM-2 e simulados cronometrados.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
